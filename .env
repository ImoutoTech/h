# 本文件是受版本控制的配置模板，仅包含占位值。
# 本地运行前直接替换占位值；生产环境应由部署平台注入同名配置，禁止提交真实密钥。
NODE_ENV=development
PORT=3000

# MySQL 5.7.44+
MYSQL_SERVER=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=h_local
MYSQL_PASSWORD=replace-with-local-database-password
MYSQL_DATABASE=h_local
TYPEORM_SYNCHRONIZE=false

# Redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_AUTHPASS=
REDIS_DATABASE=1

# H 现有会话与密码配置
PWD_SALT_ROUND=10
TOKEN_SECRET=replace-with-at-least-32-random-bytes

# OIDC 对外地址与签名材料
OIDC_ISSUER=http://localhost:3000/oidc
PUBLIC_URL=http://localhost:3000
SAFE_HOUSE_PUBLIC_URL=http://localhost:5173
# 允许访问 H HTTP 接口的前端来源。
ALLOWED_ORIGIN=http://localhost:5173
OIDC_SIGNING_JWK={"kty":"RSA","kid":"replace-current-kid","use":"sig","alg":"RS256","n":"replace","e":"AQAB","d":"replace","p":"replace","q":"replace","dp":"replace","dq":"replace","qi":"replace"}
OIDC_SIGNING_KID=replace-current-kid
# 仅在签名密钥轮换窗口内同时设置以下两个旧密钥字段。
OIDC_PREVIOUS_PUBLIC_JWK=
OIDC_PREVIOUS_KID=

# 两个独立的 32 字节 Base64 AES-GCM 密钥，禁止复用。
OIDC_CLIENT_SECRET_KEY=replace-with-base64-encoded-32-byte-key
OIDC_CLIENT_SECRET_KEY_VERSION=v1
PROVIDER_SECRET_KEY=replace-with-a-different-base64-encoded-32-byte-key
PROVIDER_SECRET_KEY_VERSION=v1

# 邮箱所有权验证。pepper 由 H 独占，不得与 notification-service 共享。
# 正整数参数可省略，默认分别为 600 秒、60 秒和 5 次。
EMAIL_VERIFICATION_PEPPER=replace-with-at-least-32-random-bytes
EMAIL_VERIFICATION_TTL_SECONDS=600
EMAIL_VERIFICATION_COOLDOWN_SECONDS=60
EMAIL_VERIFICATION_MAX_ATTEMPTS=5

# H 调用 notification-service 发送验证邮件所使用的 confidential client。
# 只授予 notification-api / notifications:send。
NOTIFICATION_API_URL=http://localhost:4100
NOTIFICATION_CLIENT_ID=replace-with-generated-h-sender-client-id
NOTIFICATION_CLIENT_SECRET=replace-with-one-time-provisioned-client-secret

# 允许调用 H Contact API 的 notification-service confidential client 列表。
# 每个客户端只授予 h-internal / users:contact:read。
NOTIFICATION_CONTACT_CLIENT_IDS=replace-with-generated-notification-service-client-id
